* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
# Compiled shader bytecode (fxc), not PostScript.
*.ps binary
spec/vectors.json linguist-generated=true
# Copies of spec/, LICENSE and NOTICE.md written by scripts/sync-skill-references.mjs. The other files under
# skills/*/references/ (api.md, recipes.md, design.md) are written by hand.
plugins/liquid-glass/skills/liquid-glass/references/optics.md linguist-generated=true
plugins/liquid-glass/skills/liquid-glass-port/references/** linguist-generated=true
plugins/liquid-glass/LICENSE linguist-generated=true
plugins/liquid-glass/NOTICE.md linguist-generated=true
plugins/liquid-glass/skills/*/LICENSE linguist-generated=true
plugins/liquid-glass/skills/*/NOTICE.md linguist-generated=true
# The shared header of the Metal shaders.
Sources/LiquidGlass/Shaders/*.h linguist-language=Metal
