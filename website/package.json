{
  "name": "liquid-glass-engineering-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "content": "node scripts/content.mjs",
    "assets": "node scripts/assets.mjs",
    "dev": "node scripts/content.mjs && vite",
    "typecheck": "node scripts/content.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src scripts --deny-warnings",
    "build": "node scripts/content.mjs && tsc -p tsconfig.json --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-links.mjs",
    "preview": "vite preview --port 4173",
    "check-links": "node scripts/check-links.mjs --strict"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "oxlint": "1.86.0",
    "sharp": "0.35.5",
    "shiki": "4.4.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "yaml": "2.9.1"
  }
}
