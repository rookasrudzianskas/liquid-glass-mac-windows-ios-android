<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lg="clr-namespace:LiquidGlass.Wpf">

  <FontFamily x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type lg:GlassScene}, ResourceId=Font}">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Glass surface -->
  <Style TargetType="{x:Type lg:GlassSurface}">
    <Setter Property="Foreground" Value="{Binding (lg:GlassScene.ContentForeground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type lg:GlassSurface}">
          <Grid x:Name="PART_Root">
            <lg:GlassLens x:Name="PART_Lens"
                          Radius="{TemplateBinding Radius}"
                          Refraction="{TemplateBinding Refraction}"
                          Tint="{TemplateBinding Tint}"
                          IsFocusRingVisible="{TemplateBinding IsFocusRingVisible}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Glass button -->
  <Style TargetType="{x:Type lg:GlassButton}">
    <Setter Property="Foreground" Value="{Binding (lg:GlassScene.ContentForeground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="FontFamily" Value="{StaticResource {ComponentResourceKey TypeInTargetAssembly={x:Type lg:GlassScene}, ResourceId=Font}}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type lg:GlassButton}">
          <lg:GlassSurface x:Name="PART_Surface"
                           Radius="{TemplateBinding Radius}"
                           Refraction="{TemplateBinding Refraction}"
                           Tint="{TemplateBinding Tint}"
                           IsInteractive="{TemplateBinding IsInteractive}"
                           IsFocusRingVisible="{Binding (lg:GlassScene.IsFocusVisible), RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{TemplateBinding Foreground}"
                           Padding="{TemplateBinding Padding}"
                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <ContentPresenter RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </lg:GlassSurface>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Surface" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,0" />
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="18,0" />
      </Trigger>
      <Trigger Property="IsIconOnly" Value="True">
        <Setter Property="Radius" Value="circle" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
