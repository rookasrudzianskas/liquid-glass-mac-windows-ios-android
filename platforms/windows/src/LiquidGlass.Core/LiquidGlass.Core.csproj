<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>LiquidGlass</RootNamespace>
    <AssemblyName>LiquidGlass.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>LiquidGlassEngineering.Core</PackageId>
    <Title>Liquid Glass Engineering: optical model</Title>
    <Description>The platform-independent optical model of Liquid Glass Engineering: continuous-corner shapes and their signed distance field, refraction, the Clear and Regular materials, tint, rim light, springs, press and drag response, and progressive blur. A faithful port of the shared reference model, verified against its golden vectors. Used by LiquidGlassEngineering.Wpf.</Description>
    <PackageTags>liquid-glass;glass;optics;refraction;material;spring;animation;ui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The PDB travels inside the library, so debuggers find symbols (and Source Link to the commit) wherever the
         package was restored from; the project feed has no symbol server. -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\packaging\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
    <!-- The license and the notices of the work the optical model is ported from travel with the package. -->
    <None Include="$(LiquidGlassRepoRoot)LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
    <None Include="$(LiquidGlassRepoRoot)NOTICE.md" Pack="true" PackagePath="\" Link="NOTICE.md" />
  </ItemGroup>

</Project>
