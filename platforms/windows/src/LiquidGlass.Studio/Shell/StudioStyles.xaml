<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="Studio.TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Studio.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Studio.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Studio.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Studio.IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Studio.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Studio.DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Studio.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Studio.DisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Section headers sit on a soft haze, as on Apple platforms: a radial backing that fades out at its edges, dark
       under the white headers of dark appearance and light under the dark ones of light appearance, so a header keeps
       at least 4.5:1 where the glass behind it is bright. The padding gives the haze room around the text; the margin
       keeps the text where it was. -->
  <Style x:Key="Studio.Section" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Studio.TextFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="-14,-10,0,0" />
    <Setter Property="Background" Value="{DynamicResource Studio.SectionHaze}" />
  </Style>

  <Style x:Key="Studio.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Studio.TextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <Style x:Key="Studio.FocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="7" BorderThickness="2" Margin="-2" BorderBrush="{DynamicResource Studio.Foreground}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation rail items, Windows 11 style: icon, label and an accent pill on the selected item. -->
  <Style x:Key="Studio.NavItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Studio.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Margin" Value="6,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Back" CornerRadius="5" Background="Transparent" />
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,0,0,0"
                    Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Visibility="Hidden" />
            <ContentPresenter x:Name="Presenter" Margin="14,0,10,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Studio.NavHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Studio.NavSelected}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Contrast theme: hover is outlined in the highlight color; the selected item is highlight with highlight text. -->
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
              <Setter TargetName="Back" Property="BorderThickness" Value="1" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
