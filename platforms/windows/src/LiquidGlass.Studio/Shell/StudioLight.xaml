<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows 11 light chrome. -->
  <SolidColorBrush x:Key="Studio.WindowBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Studio.Foreground" Color="#1B1B1F" />
  <SolidColorBrush x:Key="Studio.Secondary" Color="#5F6066" />
  <SolidColorBrush x:Key="Studio.NavHover" Color="#0A000000" />
  <SolidColorBrush x:Key="Studio.NavSelected" Color="#0F000000" />
  <SolidColorBrush x:Key="Studio.ContentStroke" Color="#14000000" />
  <RadialGradientBrush x:Key="Studio.SectionHaze">
    <GradientStop Color="#73FFFFFF" Offset="0" />
    <GradientStop Color="#66FFFFFF" Offset="0.75" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </RadialGradientBrush>
</ResourceDictionary>
