<local:StudioPageBase x:Class="LiquidGlass.Studio.Pages.ControlsPage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:lg="https://liquid-glass-engineering.vercel.app/wpf"
                      xmlns:local="clr-namespace:LiquidGlass.Studio.Pages">
  <local:StudioPageBase.Resources>
    <Style x:Key="Card" TargetType="lg:GlassSurface">
      <Setter Property="Material" Value="Regular" />
      <Setter Property="Radius" Value="26" />
      <Setter Property="Padding" Value="22,18,22,22" />
      <Setter Property="Margin" Value="10" />
    </Style>
    <Style x:Key="Icon" TargetType="lg:GlassButton">
      <Setter Property="IsIconOnly" Value="True" />
      <Setter Property="FontFamily" Value="{StaticResource Studio.IconFont}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </local:StudioPageBase.Resources>

  <lg:GlassScene x:Name="Scene">
    <lg:GlassScene.Content>
      <Image x:Name="Wallpaper" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
    </lg:GlassScene.Content>

    <Grid Margin="22" MaxWidth="980" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Buttons -->
      <lg:GlassSurface Grid.ColumnSpan="2" Style="{StaticResource Card}">
        <StackPanel lg:GlassScene.Material="Clear">
          <TextBlock Text="Buttons" Style="{StaticResource Studio.Section}" />
          <WrapPanel>
            <lg:GlassButton Content="Small" Size="Small" Margin="0,0,10,10" VerticalAlignment="Center" />
            <lg:GlassButton Content="Regular" Margin="0,0,10,10" VerticalAlignment="Center" />
            <lg:GlassButton Content="Large" Size="Large" Margin="0,0,22,10" VerticalAlignment="Center" />
            <lg:GlassButton Content="Continue" Tint="#0067C0" Margin="0,0,10,10" VerticalAlignment="Center" />
            <lg:GlassButton Content="Done" Tint="#30D158" Margin="0,0,10,10" VerticalAlignment="Center" />
            <lg:GlassButton Content="Delete" Tint="#C42B1C" Margin="0,0,10,10" VerticalAlignment="Center" />
            <lg:GlassButton Content="Disabled" IsEnabled="False" Margin="0,0,10,10" VerticalAlignment="Center" />
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
            <lg:GlassButton Style="{StaticResource Icon}" Size="Small" Content="&#xE734;" FontSize="11" AutomationProperties.Name="Favorite" />
            <lg:GlassButton Style="{StaticResource Icon}" Content="&#xE72D;" FontSize="14" AutomationProperties.Name="Share" />
            <lg:GlassButton Style="{StaticResource Icon}" Size="Large" Content="&#xE710;" FontSize="16" AutomationProperties.Name="Add" />
            <lg:GlassButton Style="{StaticResource Icon}" Size="Large" Content="&#xE768;" FontSize="16" Tint="#0067C0" AutomationProperties.Name="Play" />
            <lg:GlassButton Style="{StaticResource Icon}" Size="Large" Content="&#xEB52;" FontSize="16" Tint="#FF375F" AutomationProperties.Name="Love" />
          </WrapPanel>
        </StackPanel>
      </lg:GlassSurface>

      <!-- Slider -->
      <lg:GlassSurface Grid.Row="1" Style="{StaticResource Card}">
        <StackPanel lg:GlassScene.Material="Clear">
          <TextBlock Text="Slider" Style="{StaticResource Studio.Section}" />
          <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE993;" FontFamily="{StaticResource Studio.IconFont}" FontSize="14" VerticalAlignment="Center" />
            <lg:GlassSlider x:Name="Volume" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100" Value="64" AutomationProperties.Name="Volume" />
            <TextBlock Grid.Column="2" Text="&#xE995;" FontFamily="{StaticResource Studio.IconFont}" FontSize="14" VerticalAlignment="Center" />
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
              <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE706;" FontFamily="{StaticResource Studio.IconFont}" FontSize="14" VerticalAlignment="Center" />
            <lg:GlassSlider x:Name="Brightness" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100" Value="30" SmallChange="1" LargeChange="10"
                            Tint="#FF9F0A" AutomationProperties.Name="Brightness" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Brightness, StringFormat={}{0:0}%}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </lg:GlassSurface>

      <!-- Switch -->
      <lg:GlassSurface Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel lg:GlassScene.Material="Clear">
          <TextBlock Text="Switch" Style="{StaticResource Studio.Section}" />
          <lg:GlassSwitch Content="Wi-Fi" IsChecked="True" Margin="0,2,0,10" />
          <lg:GlassSwitch Content="Bluetooth" Margin="0,0,0,10" />
          <lg:GlassSwitch Content="Focus" IsChecked="True" Tint="#5E5CE6" />
        </StackPanel>
      </lg:GlassSurface>

      <!-- Tab bar -->
      <lg:GlassSurface Grid.Row="2" Style="{StaticResource Card}">
        <StackPanel lg:GlassScene.Material="Clear">
          <TextBlock Text="Tab bar" Style="{StaticResource Studio.Section}" />
          <lg:GlassTabBar SelectedIndex="1" HorizontalAlignment="Left" AutomationProperties.Name="Range">
            <lg:GlassTabBarItem Content="Day" />
            <lg:GlassTabBarItem Content="Week" />
            <lg:GlassTabBarItem Content="Month" />
            <lg:GlassTabBarItem Content="Year" />
          </lg:GlassTabBar>
        </StackPanel>
      </lg:GlassSurface>

      <!-- Menu -->
      <lg:GlassSurface Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
        <StackPanel lg:GlassScene.Material="Clear">
          <TextBlock Text="Menu" Style="{StaticResource Studio.Section}" />
          <StackPanel Orientation="Horizontal">
            <!-- No fixed automation name: the trigger's label, which names the current sort, is what Narrator reads. -->
            <lg:GlassMenu x:Name="SortMenu" Header="Sort by name">
              <lg:GlassMenuItem x:Name="SortName" Header="Name" IsCheckable="True" IsChecked="True" Click="OnSort" />
              <lg:GlassMenuItem x:Name="SortDate" Header="Date modified" IsCheckable="True" Click="OnSort" />
              <lg:GlassMenuItem x:Name="SortSize" Header="Size" IsCheckable="True" Click="OnSort" />
              <Separator />
              <lg:GlassMenuItem Header="Show hidden files" IsCheckable="True" StaysOpenOnClick="True" />
            </lg:GlassMenu>
            <lg:GlassMenu IsIconOnly="True" Header="&#xE712;" FontFamily="{StaticResource Studio.IconFont}" Margin="10,0,0,0" AutomationProperties.Name="More">
              <lg:GlassMenuItem Header="Copy" Icon="&#xE8C8;" InputGestureText="Ctrl+C" />
              <lg:GlassMenuItem Header="Rename" Icon="&#xE8AC;" InputGestureText="F2" />
              <lg:GlassMenuItem Header="Delete" Icon="&#xE74D;" InputGestureText="Del" />
            </lg:GlassMenu>
          </StackPanel>
        </StackPanel>
      </lg:GlassSurface>
    </Grid>
  </lg:GlassScene>
</local:StudioPageBase>
