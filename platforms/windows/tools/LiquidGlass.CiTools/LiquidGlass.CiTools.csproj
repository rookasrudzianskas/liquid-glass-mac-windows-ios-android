<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows CI helpers: render-capability probe, window capture and the GPU check of the shader library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LiquidGlass.CiTools</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LiquidGlass.Wpf\LiquidGlass.Wpf.csproj" />
  </ItemGroup>

</Project>
