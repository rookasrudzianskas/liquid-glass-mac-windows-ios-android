<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests: WPF controls, the shader bytecode, and the HLSL library on the GPU (WARP). They run against
       each build the package ships: .NET 10, .NET 8 and .NET Framework 4.8. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>LiquidGlass.Wpf.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <!-- The GPU check of the HLSL library is independent of the .NET build: it runs once, on .NET 10. -->
    <Compile Remove="GpuTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LiquidGlass.Wpf\LiquidGlass.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(LiquidGlassRepoRoot)spec\vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\LiquidGlass.Wpf\Shaders\LiquidGlass.hlsli" Link="Shaders\LiquidGlass.hlsli" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\GpuCheck.hlsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
