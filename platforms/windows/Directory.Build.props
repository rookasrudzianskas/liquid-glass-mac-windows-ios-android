<Project>
  <!-- Shared settings for every project in the Windows port. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- WPF projects build on macOS and Linux too; only running them needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.2</Version>
    <Authors>Liquid Glass Engineering</Authors>
    <Company>Liquid Glass Engineering</Company>
    <Product>Liquid Glass Engineering</Product>
    <!-- The holder named in the repository's LICENSE. -->
    <Copyright>Copyright (c) 2026 Rokas Rudzianskas</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <RepositoryUrl>https://github.com/rookasrudzianskas/liquid-glass-mac-windows-ios-android</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://liquid-glass-engineering.vercel.app</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Liquid Glass Engineering 1.0.2: a patch release with no change to the Core and WPF libraries, whose code and API are those of the previous release; it brings a new build toolchain for the Android library, its sources and javadoc on JitPack, and the website and security work. Changes: https://github.com/rookasrudzianskas/liquid-glass-mac-windows-ios-android/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Repository paths used by tests, the demo and packaging. -->
    <LiquidGlassRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</LiquidGlassRepoRoot>
    <LiquidGlassWindowsRoot>$(MSBuildThisFileDirectory)</LiquidGlassWindowsRoot>
  </PropertyGroup>
</Project>
